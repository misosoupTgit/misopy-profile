# CurseForge for Studios API key — https://console.curseforge.com/
# Paste the key as-is (including `$` characters). Do not wrap in quotes.
# Local Vite loads this without `$` expansion (see vite.config.ts).
#
# Cloudflare Pages: Variables and secrets (Production). Prefer Base64 if `$` causes issues:
#   CURSEFORGE_API_KEY_B64=<base64 of the raw key>
#   PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content .env | ? { $_ -like 'CURSEFORGE_API_KEY=*' }).Substring(19)))
CURSEFORGE_API_KEY=
CURSEFORGE_API_KEY_B64=

CURSEFORGE_AUTHOR_NAME=MisoPy
CURSEFORGE_AUTHOR_ID=
MODRINTH_USERNAME=MisoPy
